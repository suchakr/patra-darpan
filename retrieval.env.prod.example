# Production host environment for the retrieval companion.
# `make PROD=1 prod-env` copies this file to /etc/patra-darpan/retrieval.env
# once and does not overwrite an existing file. Adjust checkout paths if needed.

# Existing read-only Sanchaya checkout used by Sanchaya-Zoekt.
SANCHAYA_REPO_ROOT=/mnt/docker-data/sanchaya-zoekt-data/repos/sanchaya

# Persistent production release, Qdrant, and model-cache data.
RETRIEVAL_RELEASE_ROOT=/mnt/docker-data/retrieval-data/releases
RETRIEVAL_QDRANT_DATA_ROOT=/mnt/docker-data/retrieval-data/qdrant
RETRIEVAL_MODEL_CACHE_ROOT=/mnt/docker-data/retrieval-data/model-cache
RETRIEVAL_AUTH_STATE_ROOT=/mnt/docker-data/retrieval-data/auth
MCP_OAUTH_ALLOWLIST_FILE=/mnt/docker-data/retrieval-data/allowed-emails.txt

# Patra Darpan semantic checkout on the production host.
RETRIEVAL_CANONICAL_CATALOG=/home/kumars/sg/patra-darpan/.build~/spasta-corpus.sqlite
RETRIEVAL_ONTOLOGY_ROOT=/home/kumars/sg/patra-darpan/ontology

# Private Zoekt RPC on the existing Sanchaya-Zoekt Docker network.
RETRIEVAL_ZOEKT_URL=http://zoekt-webserver:6070
RETRIEVAL_ZOEKT_NETWORK=sanchaya-zoekt_default

# Pilot scope and embedding build settings.
RETRIEVAL_PAPER_SCOPE=all
RETRIEVAL_SANCHAYA_SCOPE=jyotisham
RETRIEVAL_VECTOR_MODEL=intfloat/multilingual-e5-base
RETRIEVAL_VECTOR_BATCH_SIZE=32

# Required for the public HTTPS MCP route. Replace the placeholder before use.
MCP_AUTH_REQUIRED=true
MCP_BEARER_TOKEN=replace-this-before-starting

# OAuth MCP edge. Register this callback with the Google OAuth client before
# exposing /mcp. Keep the client secret and allowlist outside Git.
MCP_OAUTH_ISSUER_URL=https://sanchaya.rasowshi.us
MCP_OAUTH_RESOURCE_URL=https://sanchaya.rasowshi.us/mcp
MCP_OAUTH_REDIRECT_URI=https://sanchaya.rasowshi.us/oauth/callback
MCP_OAUTH_GOOGLE_CLIENT_ID=replace-this-before-starting
MCP_OAUTH_GOOGLE_CLIENT_SECRET=replace-this-before-starting
MCP_OAUTH_GOOGLE_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo
MCP_OAUTH_SCOPE=mcp
