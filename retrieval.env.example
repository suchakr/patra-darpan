# Copy this file to a local, untracked .env file or pass it with
# `docker compose --env-file ...`. These are host paths used by Compose for
# bind mounts; setting them inside a container is too late.

# macOS development example:
SANCHAYA_REPO_ROOT=/Users/your-user/projects/sanchaya
RETRIEVAL_RELEASE_ROOT=/Users/your-user/projects/patra-darpan-pdf-semantic-index/.local/retrieval/releases
RETRIEVAL_CANONICAL_CATALOG=/Users/your-user/projects/patra-darpan/.build~/spasta-corpus.sqlite
RETRIEVAL_QDRANT_DATA_ROOT=/Users/your-user/projects/patra-darpan-pdf-semantic-index/.local/retrieval/qdrant
# Omit this when Compose owns qdrant; set it to host.docker.internal when
# reusing an already-running local Qdrant container.
# RETRIEVAL_QDRANT_URL=http://host.docker.internal:6333
RETRIEVAL_MODEL_CACHE_ROOT=/Users/your-user/.cache/huggingface
RETRIEVAL_ONTOLOGY_ROOT=/Users/your-user/projects/patra-darpan-pdf-semantic-index/ontology
RETRIEVAL_ZOEKT_URL=http://host.docker.internal:6070
# One-shot builder defaults: all exported papers plus all Jyotisham text.
# Set RETRIEVAL_PAPER_SCOPE=audit for the 29-paper calibration release.
RETRIEVAL_PAPER_SCOPE=all
RETRIEVAL_SANCHAYA_SCOPE=jyotisham
RETRIEVAL_VECTOR_MODEL=intfloat/multilingual-e5-base
RETRIEVAL_VECTOR_BATCH_SIZE=32

# Trusted-demo bearer authentication. Keep the real value in an untracked
# env file; the MCP service returns 401 when it is missing or incorrect.
MCP_AUTH_REQUIRED=true
MCP_BEARER_TOKEN=replace-with-demo-token

# Production example (replace the PD checkout path and private Zoekt port):
# SANCHAYA_REPO_ROOT=/mnt/docker-data/sanchaya-zoekt-data/repos/sanchaya
# RETRIEVAL_RELEASE_ROOT=/mnt/docker-data/retrieval-data/releases
# RETRIEVAL_CANONICAL_CATALOG=/home/your-user/sg/patra-darpan/.build~/spasta-corpus.sqlite
# RETRIEVAL_QDRANT_DATA_ROOT=/mnt/docker-data/retrieval-data/qdrant
# RETRIEVAL_MODEL_CACHE_ROOT=/mnt/docker-data/retrieval-data/model-cache
# RETRIEVAL_ONTOLOGY_ROOT=/home/your-user/sg/patra-darpan/ontology
# The production overlay keeps Qdrant private and supplies this service URL.
# RETRIEVAL_QDRANT_URL=http://qdrant:6333
# RETRIEVAL_ZOEKT_URL=http://zoekt-webserver:6070
# RETRIEVAL_ZOEKT_NETWORK=sanchaya-zoekt_default
# Set MCP_BEARER_TOKEN in the untracked production env file. The production
# Caddy route exposes HTTPS /mcp; do not publish 8787 or 6333.
