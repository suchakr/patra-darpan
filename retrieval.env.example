# Copy this file to a local, untracked .env file or pass it with
# `docker compose --env-file ...`. These are host paths used by Compose for
# bind mounts; setting them inside a container is too late.

# macOS development example:
SANCHAYA_REPO_ROOT=/Users/your-user/projects/sanchaya
RETRIEVAL_RELEASE_ROOT=/Users/your-user/projects/patra-darpan-pdf-semantic-index/.local/retrieval/releases
RETRIEVAL_QDRANT_DATA_ROOT=/Users/your-user/projects/patra-darpan-pdf-semantic-index/.local/retrieval/qdrant
RETRIEVAL_MODEL_CACHE_ROOT=/Users/your-user/.cache/huggingface
RETRIEVAL_ONTOLOGY_ROOT=/Users/your-user/projects/patra-darpan-pdf-semantic-index/ontology
RETRIEVAL_ZOEKT_URL=http://host.docker.internal:6070

# Production example (replace the PD checkout path and private Zoekt port):
# SANCHAYA_REPO_ROOT=/mnt/docker-data/sanchaya-zoekt-data/repos/sanchaya
# RETRIEVAL_RELEASE_ROOT=/mnt/docker-data/retrieval-data/releases
# RETRIEVAL_QDRANT_DATA_ROOT=/mnt/docker-data/retrieval-data/qdrant
# RETRIEVAL_MODEL_CACHE_ROOT=/mnt/docker-data/retrieval-data/model-cache
# RETRIEVAL_ONTOLOGY_ROOT=/home/your-user/sg/patra-darpan/ontology
# RETRIEVAL_ZOEKT_URL=http://host.docker.internal:6070
