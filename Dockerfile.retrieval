# Runtime image for the read-only retrieval MCP service.
#
# The model weights are deliberately not baked into the image.  Mount
# RETRIEVAL_MODEL_CACHE_ROOT at runtime so the same image can be used on a
# developer machine and on the production host without rebuilding for each
# model download.

FROM python:3.12-slim AS retrieval-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/cache/huggingface

WORKDIR /app

# sentence-transformers is needed at query time to embed vector-search
# questions. qdrant-client talks to the separate Qdrant service; requests is
# used by the Zoekt adapter. The x86 production host has no CUDA runtime, so
# use PyTorch's CPU wheel there; the generic Linux wheel pulls several GB of
# NVIDIA libraries. Keep the generic package on other architectures, including
# the ARM64 development container.
ARG TARGETARCH
RUN arch="${TARGETARCH}"; \
    if [ -z "$arch" ]; then arch="$(dpkg --print-architecture)"; fi; \
    if [ "$arch" = "amd64" ]; then \
      python -m pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        "torch==2.5.1+cpu"; \
    else \
      python -m pip install --no-cache-dir "torch==2.5.1"; \
    fi \
    && python -m pip install --no-cache-dir \
      "mcp==1.30.0" \
      "qdrant-client==1.14.1" \
      "sentence-transformers==3.4.1" \
      "transformers==4.48.3" \
      "httpx==0.28.1" \
      "requests"

COPY lib /app/lib
COPY scripts /app/scripts
COPY ontology /app/ontology
COPY docs/retrieval/search-guide.md /app/docs/retrieval/search-guide.md

ENV MCP_HOST=0.0.0.0 \
    MCP_PORT=8787 \
    MCP_TRANSPORT=streamable-http

CMD ["python", "scripts/retrieval_mcp_server.py"]

# The builder uses the same dependencies and source tree.  Keeping a named
# target lets Compose build it independently when release materialization is
# containerized later, without changing the runtime image contract.
FROM retrieval-runtime AS retrieval-builder

# The builder validates the pinned Sanchaya/Patra Darpan revisions before
# emitting a release. Git is intentionally absent from the read-only runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

CMD ["python", "scripts/create_retrieval_release.py"]
